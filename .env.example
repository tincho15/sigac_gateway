# PORT=3000

# # Base de datos levantada con docker-compose (valores por defecto).
# # Si usas un PostgreSQL instalado localmente, reemplaza usuario, password y base.
# POSTGRES_USER=sigac
# POSTGRES_PASSWORD=sigac
# POSTGRES_DB=sigac
# POSTGRES_PORT=5433

DATABASE_URL="postgresql://sigac:sigac@localhost:5433/sigac?schema=public"

POSTGRES_USER=sigac_user
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sigac
POSTGRES_PORT=5432

BACKEND_PORT=3000

JWT_SECRET=una_clave_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# Autenticacion de dos factores (Google Authenticator / TOTP)
# Clave de 32 bytes en hexadecimal para cifrar los secretos TOTP en la base.
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
# Nombre que muestra la app autenticadora junto a la cuenta
TOTP_ISSUER=SIGAC
# Vigencia del token intermedio entre la contraseña y el codigo
TWO_FACTOR_TOKEN_EXPIRES_IN=5m

# 2FA obligatoria: cada usuario debe activarla antes de usar el sistema (false = opcional)
TWO_FACTOR_REQUIRED=true
