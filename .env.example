PORT=3000

# Base de datos levantada con docker-compose (valores por defecto).
# Si usas un PostgreSQL instalado localmente, reemplaza usuario, password y base.
POSTGRES_USER=sigac
POSTGRES_PASSWORD=sigac
POSTGRES_DB=sigac
POSTGRES_PORT=5433

DATABASE_URL="postgresql://sigac:sigac@localhost:5433/sigac?schema=public"
